# Copy to terraform.tfvars and adjust as needed.

aws_region   = "eu-central-1"
project_name = "nginx-icap-module-demo"

# Restrict this to your own IP (e.g. "203.0.113.4/32") before applying —
# 0.0.0.0/0 opens SSH to the internet.
ssh_cidr_blocks = ["0.0.0.0/0"]

# Restrict this to your own IP (e.g. "203.0.113.4/32") before applying —
# 0.0.0.0/0 opens HTTP to the internet.
http_cidr_blocks = ["0.0.0.0/0"]

# Restrict this to your own IP (e.g. "203.0.113.4/32") before applying —
# 0.0.0.0/0 opens HTTP to the internet.
https_cidr_blocks = ["0.0.0.0/0"]

# Restrict this to your own IP (e.g. "203.0.113.4/32") before applying —
# 0.0.0.0/0 opens HTTP to the internet.
grafana_cidr_blocks = ["0.0.0.0/0"]

# Optional: name of an existing EC2 key pair for SSH access.
# key_name = "my-keypair"

# Pre-allocated Elastic IP (see eip.tf) — kept out of Terraform's
# create/destroy cycle so it survives `terraform destroy` between sessions.
elastic_ip_allocation_id = "eipalloc-xxxxxxxxx"    # nginx-icap-module-eip