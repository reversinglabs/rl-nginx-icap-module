ARG NGINX_VERSION=1.29.8

FROM nginx:${NGINX_VERSION}

# Prebuilt dynamic module, packaged as a .deb by the sibling
# nginx-icap-module-src checkout — installs to
# /usr/lib/nginx/modules/ngx_http_detect_icap_module.so, which this image's
# /etc/nginx/modules (nginx's --modules-path, and where nginx.docker.conf's
# `load_module modules/...` resolves against) is already a symlink to.
# No `apt-get -f`/dependency resolution needed: the module only links
# libssl/libcrypto/libz, all already present since nginx itself needs them.
COPY module/nginx-icap-module.deb /tmp/nginx-icap-module.deb
RUN dpkg -i /tmp/nginx-icap-module.deb && rm -f /tmp/nginx-icap-module.deb

# template Nginx conf.
COPY nginx.docker.conf /etc/nginx/nginx.conf.template

# Cert + key for the HTTPS listener (8443) are not baked into this image —
# see the "certificates" service in docker-compose-certbot.yml and docker-compose-certgen.yml.

EXPOSE 8080 8443
# envsubst replaces only the ICAP_* variables; nginx variables like $host are left intact.
CMD ["/bin/sh", "-c", \
    "envsubst '${ICAP_SCHEME}${ICAP_HOSTNAME}${ICAP_PORT}${ICAP_SERVICE}${ICAP_AUTH}${ICAP_SSL_TRUSTED_CERT}${ICAP_SSL_NAME}' \
        < /etc/nginx/nginx.conf.template \
        > /etc/nginx/nginx.conf \
     && nginx -g 'daemon off;'"]
