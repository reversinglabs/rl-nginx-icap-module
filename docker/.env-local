COMPOSE_PROJECT_NAME=nginx-icap-demo-local
COMPOSE_PROFILES=ce,local-icap,test
# COMPOSE_PROFILES=plus,local-icap,test

NGINX_VERSION=1.29.8
# Uncomment for plus (see .env-default for what each does):
# UBUNTU_VERSION=24.04
# NGINX_PLUS_SW_ROOT=~/nginx/versions
# NGINX_PLUS_DEB=nginx-plus_37.0.4-1-noble_amd64.deb
# NGINX_PLUS_LICENSE=~/nginx/license/nginx-one-eval.jwt

NGINX_PORT=80
NGINX_HTTPS_PORT=443

ICAP_SCHEME=http
ICAP_HOSTNAME=icap-server
ICAP_PORT=1344
ICAP_SERVICE=detect

BACKEND_REPLICAS=1
SAMPLES_FOLDER=../files
