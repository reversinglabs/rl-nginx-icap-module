COMPOSE_PROJECT_NAME=nginx-icap-demo-rl-dev
# COMPOSE_PROFILES=ce,test
COMPOSE_PROFILES=plus,test

# used for ce
NGINX_VERSION=1.29.8
# used for plus
UBUNTU_VERSION=24.04
# Directory holding NGINX Plus install packages -- NGINX_PLUS_DEB below is a
# filename (or relative path) resolved against this, not against this repo.
NGINX_PLUS_SW_ROOT=~/nginx/versions
NGINX_PLUS_DEB=nginx-plus_37.0.4-1-noble_amd64.deb
# NGINX Plus license -- a plain path, not resolved against NGINX_PLUS_SW_ROOT.
NGINX_PLUS_LICENSE=~/nginx/license/nginx-one-eval.jwt

NGINX_PORT=80
NGINX_HTTPS_PORT=443

ICAP_SCHEME=http
ICAP_HOSTNAME=a1000-integrations.rl.lan
ICAP_PORT=1344
ICAP_SERVICE=srv-rl

BACKEND_REPLICAS=1
SAMPLES_FOLDER=/mnt/diskstation/various/mslivonja
